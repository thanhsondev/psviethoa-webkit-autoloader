# Compiled Binaries
*.elf
*.bin
*.o

# ...but vendored third_party snapshots must ship their payload binaries
# (they used to live in submodules; with a vendored tree they are build inputs)
!third_party/**/*.elf
!third_party/**/*.bin

# Downloaded ps5-unified-autoloader payload (scripts/download_deps.sh) + digest sidecar
frontend/autoloader/payloads/

# Generated File Registry
include/file_registry.h
include/file_registry.c
include/.file_registry.stamp

# Generated version header (tools/gen_version.py)
include/wkali_version.h

# Generated PS5 app metadata (tools/gen_version.py, template: assets/param.json.template)
assets/param.json

# Generated icon assets (tools/gen_icons.py, master: assets/icon.svg)
assets/icon0.png
assets/icon.ico
frontend/installer-page/favicon.svg
frontend/autoloader/favicon.svg
frontend/installer-page/logo.svg
frontend/autoloader/logo.svg

# Generated frontend stage (installer-page + autoloader merged at build time)
frontend/dist/

# umtx2 copy generated by tools/apply_umtx2_patch.sh from third_party/umtx2
frontend/autoloader/umtx2/

# relapse copy generated by tools/apply_relapse_patch.sh from third_party/relapse
frontend/autoloader/relapse/

# PC host build artifacts (tools/build_host.py, PyInstaller)
psviethoa-webkit-autoloader-host.py
psviethoa-webkit-autoloader-host_v*.py
psviethoa-webkit-autoloader-host.exe
psviethoa-webkit-autoloader-host_v*.exe
psviethoa-webkit-autoloader-host.spec
build/
dist/

# OS specific
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Logs
*.log

# Reference materials
.for_reference/
